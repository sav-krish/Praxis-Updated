# --- Production hosts (e.g. Vercel) ---
# Use real NEXT_PUBLIC_SUPABASE_URL and publishable/anon key values — not placeholders containing
# "your-" — so the session proxy can refresh cookies and enforce protected-route redirects.
# Stripe webhooks: set STRIPE_WEBHOOK_SECRET and SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY
# so /api/stripe/webhook can sync subscriptions (returns 503 if service role is missing).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_…) – preferred. Legacy: NEXT_PUBLIC_SUPABASE_ANON_KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret key (sb_secret_…) for server/admin – preferred. Legacy: SUPABASE_SERVICE_ROLE_KEY
# Required for admin email recipients (bypasses RLS to list all professors), Stripe webhook sync,
# seed/delete showcase scripts (`pnpm seed:showcase`, etc.).
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin access: comma-separated emails that can see Admin – Feedback and Admin – Emails
# ADMIN_EMAILS=you@example.com,other@example.com

# Gemini (required for AI generation, copilot, analytics insight, embeddings)
GEMINI_API_KEY=your-gemini-api-key
# Optional: default chat/completion model
# GEMINI_MODEL=gemini-2.0-flash
# Optional: separate model for simulation outline pass
# GEMINI_OUTLINE_MODEL=gemini-2.0-flash
# Optional: embedding model for knowledge-base RAG
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# Bulk case-study import (`pnpm bulk:case-studies`) — UUID from Supabase Auth (same as professors.id)
# BULK_PROFESSOR_USER_ID=
# BULK_SKIP_INFER=1
# BULK_SKIP_STORAGE=1
# BULK_INFER_MODEL=gemini-2.0-flash
# BULK_DELAY_MS=1500
# BULK_RAG_LIMIT=8
# BULK_COURSE_TOPIC=
# BULK_GOAL=
# BULK_TARGET_DECISIONS=
# BULK_AI_NOTES=
# BULK_RAG_SUBJECT=
# BULK_DIFFICULTY=

# Optional showcase seed cleanup (delete-showcase script)
# DEBUG_SHOWCASE_DELETE=1

# Optional: multiline product goals for Admin → Analytics “Generate insight” (evaluates metrics against these)
# PRAXIS_ANALYTICS_GOALS=Grow professor-authored simulations.\nDrive live classroom sessions and student responses.

# Optional: public app URL for share links (auto-detected on Vercel)
# NEXT_PUBLIC_APP_URL=https://praxis.vercel.app

# Email (optional; Resend integration — when set, real emails are sent)
# RESEND_API_KEY=re_your-resend-api-key
# RESEND_FROM=Praxis <noreply@yourdomain.com>

# Stripe (optional — for paid subscriptions)
# Get keys from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# STRIPE_PLAN_NAME=Pro
