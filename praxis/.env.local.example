# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (required for AI generation; optional if authoring manually)
OPENAI_API_KEY=sk-your-openai-key

# Optional: override the default model (gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# Optional: public app URL for share links (auto-detected on Vercel)
# NEXT_PUBLIC_APP_URL=https://praxis.vercel.app
